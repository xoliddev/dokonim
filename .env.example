# Do'konim API configuration. Copy to .env and fill in. Placeholders only — never commit real values.
NODE_ENV=production
PORT=8080

# Postgres connection (role must own the schema; it runs the migrations). docker-compose overrides this.
DATABASE_URL=postgres://dokonim:dokonim@localhost:5432/dokonim

# Public https URL of this API (webhook URLs shown to store owners, OpenAPI servers).
PUBLIC_URL=https://api.example.com
# https URL where the Mini App is hosted (web_app buttons).
MINIAPP_URL=https://app.example.com

# Telegram bot from @BotFather. Leave BOT_TOKEN empty to run without Telegram login/notifications.
BOT_TOKEN=
BOT_USERNAME=your_bot_username
# Secret for X-Telegram-Bot-Api-Secret-Token on POST /hooks/telegram (16+ chars of A-Z a-z 0-9 _ -).
# Generate: openssl rand -hex 24
BOT_WEBHOOK_SECRET=

# HS256 secret for access tokens, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=<replace-with-output-of-openssl-rand-hex-32>
# Key-encryption key for payment-provider credentials: exactly 64 hex chars. Generate: openssl rand -hex 32
CREDENTIALS_KEK=<replace-with-64-hex-chars>

# Comma-separated origins allowed by CORS (the Mini App origin).
CORS_ORIGINS=https://app.example.com
# Comma-separated Telegram user ids that get platform-admin rights on login.
PLATFORM_ADMIN_TELEGRAM_IDS=
